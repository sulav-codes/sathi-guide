generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// BOUNDED CONTEXT 1: IDENTITY & AUTH
// ============================================================

enum Role {
  TOURIST
  GUIDE
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum IDDocumentType {
  CITIZENSHIP
  PASSPORT
  DRIVING_LICENSE
  NATIONAL_ID
}

// ── Core Identity ────────────────────────────────────────────

// User is auth-only. No business data here.
// Business profile lives in TouristProfile / GuideProfile.
// This enforces: auth changes never touch domain models.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String?   @unique
  passwordHash String
  role         Role      @default(TOURIST)

  // Account health flags — auth concern, not business concern
  isEmailVerified Boolean   @default(false)
  isPhoneVerified Boolean   @default(false)
  isActive        Boolean   @default(true)
  isBanned        Boolean   @default(false)

  // Avatar stored as Media reference — URL built at API layer
  avatarId  String?
  avatar    Media?   @relation(fields: [avatarId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // Soft delete for GDPR right-to-erasure
  lastLoginAt DateTime?

  // ── Auth relations ───────────────────────────────────────
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  deviceTokens            DeviceToken[]

  // ── Profile relations (1:1) ──────────────────────────────
  touristProfile TouristProfile?
  guideProfile   GuideProfile?
  adminProfile   AdminProfile?

  // ── Domain relations ─────────────────────────────────────
  // These exist here for FK integrity only.
  // Business logic lives in domain services, not User model.
  //
  // NOTE: There is no `bookingsAsGuide` here. A booking's guide is
  // reached via Booking → Experience → GuideProfile → User.
  // Duplicating guideId on Booking would create two sources of truth
  // for "who is the guide on this booking" — avoided intentionally.
  bookingsAsTourist   Booking[]                 @relation("TouristBookings")
  reviewsAuthored     Review[]                  @relation("ReviewAuthor")
  receivedReviews     Review[]                  @relation("ReviewSubject")
  messagesSent        Message[]
  conversationSeats   ConversationParticipant[]
  notifications       Notification[]
  banHistory          UserBan[]
  auditActionsAsActor AuditLog[]                @relation("AuditActor")

  reportsSubmitted Report[] @relation("ReportReporter")
  reportsReceived  Report[] @relation("ReportTarget")

  @@index([email])
  @@index([phone])
  @@index([role, isActive])
  @@index([deletedAt])
  @@map("users")
}

// ── Auth Tokens ──────────────────────────────────────────────

model RefreshToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Argon2id hash of the actual token sent to client.
  // Never store raw tokens — treat like passwords.
  tokenHash String @unique

  // family groups all rotations from one login session.
  // On theft detection: WHERE family = X → SET isRevoked = true
  family String

  // Session context for anomaly detection
  deviceId   String?
  deviceName String?
  ipAddress  String?
  userAgent  String?

  isRevoked     Boolean   @default(false)
  revokedAt     DateTime?
  // Reason enum avoided intentionally — reason is app-layer concern
  revokedReason String?

  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
  @@index([family])    // Family invalidation query
  @@index([tokenHash]) // Login verification query
  @@index([expiresAt]) // Cleanup job query
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash       String    @unique
  isUsed          Boolean   @default(false)
  usedAt          DateTime?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  requestedFromIp String?

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  // Store target email explicitly — supports email-change verification flow.
  // User.email is only updated AFTER this token is consumed.
  targetEmail String

  isUsed    Boolean   @default(false)
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("email_verification_tokens")
}

// Push notification device registration.
// Multiple devices per user — mobile-first architecture.
model DeviceToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // FCM / APNs token
  token      String    @unique
  platform   String    // "android" | "ios" | "web"
  deviceId   String?
  deviceName String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSeenAt DateTime?

  @@index([userId, isActive])
  @@index([deviceId])
  @@map("device_tokens")
}

// Append-only ban history — preserves full moderation audit trail.
// Never mutate — always insert a new record.
// Current ban status derived from latest record WHERE isLifted = false.
model UserBan {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  reason     String
  bannedById String    // Admin UserId
  bannedAt   DateTime  @default(now())

  isLifted   Boolean   @default(false)
  liftedAt   DateTime?
  liftedById String?
  liftNote   String?

  expiresAt DateTime? // Null = permanent

  @@index([userId])
  @@index([isLifted])
  @@map("user_bans")
}

// ── Role Profiles ────────────────────────────────────────────

// Tradeoff: 1:1 profiles add a join, but eliminate nullable column sprawl.
// GuideProfile has 20+ guide-specific columns — putting these on User
// would make the User table unusable for tourists and admins.
model TouristProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName              String
  displayName           String?
  bio                   String?
  gender                Gender?
  dateOfBirth           DateTime?
  nationality           String?
  preferredLanguage     String    @default("en")
  emergencyContactName  String?
  emergencyContactPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tourist_profiles")
}

model GuideProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName            String
  displayName         String?
  bio                 String?  @db.Text
  gender              Gender?
  dateOfBirth         DateTime?
  languagesSpoken     String[] @default([])
  experienceYears     Int      @default(0)
  totalTripsCompleted Int      @default(0)

  // Denormalized aggregate — updated by application after each review.
  // Alternative: computed via DB view. Chosen for query simplicity.
  averageRating Decimal @default(0) @db.Decimal(3, 2)
  totalReviews  Int     @default(0)

  // Financial aggregates — updated on payment settlement.
  // Source of truth is Payment table. These are display caches.
  totalEarnings Decimal @default(0) @db.Decimal(12, 2)
  pendingPayout Decimal @default(0) @db.Decimal(12, 2)

  // Verification state — managed by GuideVerification workflow
  currentVerificationStatus VerificationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verificationWorkflow GuideVerification[]
  idDocuments          GuideIDDocument[]
  expertiseCategories  GuideExpertise[]
  location             GuideLocation?

  // What this guide sells. Pricing and availability now live on
  // Experience, not here — see BOUNDED CONTEXT 3.
  experiences Experience[]

  // Guide-wide (not experience-specific) scheduling constraints.
  blockedPeriods    GuideBlockedPeriod[]
  availabilityLocks AvailabilityLock[]

  @@index([currentVerificationStatus])
  @@index([averageRating])
  @@index([experienceYears])
  @@map("guide_profiles")
}

model AdminProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName     String
  department   String?
  isSuperAdmin Boolean  @default(false)
  permissions  String[] // Fine-grained permissions: ["verify_guides", "manage_payments"]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_profiles")
}

// ============================================================
// BOUNDED CONTEXT 2: GUIDE DOMAIN
// ============================================================
// Responsibility: Guide identity, verification, expertise areas,
// base location, and guide-wide scheduling constraints.
//
// What this context deliberately does NOT own anymore:
//   - Pricing            → now on Experience (a guide has many rates,
//                           one per offering, not one global rate)
//   - Offering-level availability → now on Experience
// A guide's real-world calendar conflict guard (AvailabilityLock) and
// guide-wide blackout dates (GuideBlockedPeriod) remain here because
// those are physical constraints on the *person*, not a specific offering.
// ============================================================

// ── Enums: Verification ──────────────────────────────────────

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

// ── Guide Verification Workflow ──────────────────────────────

// Append-only verification history — never update, always insert.
// Current status = latest record. Admin has full audit trail.
// This replaces a single "verificationStatus" field + scattered update logic.
model GuideVerification {
  id             String       @id @default(cuid())
  guideProfileId String
  guideProfile   GuideProfile @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)

  status            VerificationStatus
  note              String?            // Admin review notes
  reviewedById      String?            // Admin UserId
  // Which documents were part of this review decision
  documentsReviewed String[]           // Array of GuideIDDocument IDs

  createdAt DateTime @default(now())

  // ⚠️ No updatedAt — this is intentionally append-only.
  // Application must never UPDATE this table — only INSERT.

  @@index([guideProfileId])
  @@index([status])
  @@index([createdAt])
  @@map("guide_verifications")
}

model GuideIDDocument {
  id             String       @id @default(cuid())
  guideProfileId String
  guideProfile   GuideProfile @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)

  documentType       IDDocumentType
  // documentNumber stored encrypted at application layer — never plaintext
  documentNumberHash String?
  frontImageId       String
  frontImage         Media          @relation("GuideDocumentFront", fields: [frontImageId], references: [id])
  backImageId        String?
  backImage          Media?         @relation("GuideDocumentBack", fields: [backImageId], references: [id])
  selfieImageId      String?
  selfieImage        Media?         @relation("GuideDocumentSelfie", fields: [selfieImageId], references: [id])

  issuingCountry  String?
  issuedAt        DateTime?
  expiresAt       DateTime?

  // Per-document status for granular rejection feedback
  status          VerificationStatus @default(PENDING)
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guideProfileId])
  @@index([status])
  @@map("guide_id_documents")
}

// ── Media (Shared Infrastructure) ───────────────────────────

model Media {
  id         String   @id @default(cuid())
  key        String   @unique
  mimeType   String
  fileSize   Int
  uploadedBy String?
  createdAt  DateTime @default(now())

  avatars               User[]
  coverImages           Destination[]
  destinationImages     DestinationImage[]
  experienceCoverImages Experience[]        @relation("ExperienceCoverImage")
  experienceImages      ExperienceImage[]
  messageAttachments    MessageAttachment[]
  guideDocumentFronts   GuideIDDocument[]   @relation("GuideDocumentFront")
  guideDocumentBacks    GuideIDDocument[]   @relation("GuideDocumentBack")
  guideDocumentSelfies  GuideIDDocument[]   @relation("GuideDocumentSelfie")

  @@map("media")
}

// ── Location (Shared Infrastructure) ────────────────────────

// Single Location model referenced everywhere.
// Eliminates "which location is truth?" confusion.
// Experience.location / Experience.meetingLocation → Location FK
// Destination → Location FK
// GuideLocation → Location FK
// One source, zero drift.
model Location {
  id          String  @id @default(cuid())
  latitude    Decimal @db.Decimal(10, 7)
  longitude   Decimal @db.Decimal(10, 7)

  // Structured address — queryable columns, not JSON
  addressLine String?
  city        String
  district    String
  province    String?
  country     String  @default("Nepal")

  // PostGIS note: Add geometry column via raw migration:
  // ALTER TABLE locations ADD COLUMN geom geometry(Point, 4326)
  //   GENERATED ALWAYS AS (ST_SetSRID(ST_MakePoint(longitude, latitude), 4326)) STORED;
  // CREATE INDEX ON locations USING GIST (geom);
  // This enables ST_DWithin radius search without changing this schema.

  createdAt DateTime @default(now())

  // Polymorphic usage via back-relations
  guideLocations          GuideLocation[]
  destinations            Destination[]
  experienceLocations     Experience[]    @relation("ExperienceLocation")
  experienceMeetingPoints Experience[]    @relation("ExperienceMeetingPoint")

  @@index([city])
  @@index([district])
  @@index([latitude, longitude])
  @@map("locations")
}

// GuideProfile's current base location — thin wrapper around Location
model GuideLocation {
  id             String       @id @default(cuid())
  guideProfileId String       @unique
  guideProfile   GuideProfile @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  locationId     String
  location       Location     @relation(fields: [locationId], references: [id])
  updatedAt      DateTime     @updatedAt

  @@index([locationId])
  @@map("guide_locations")
}

// ── Expertise ─────────────────────────────────────────────────
// Shared taxonomy used both for a guide's general expertise areas
// (GuideExpertise — broad, display-level) and for classifying a
// specific bookable offering (Experience.category).

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  iconKey     String?
  color       String? // Hex color for frontend display (e.g. "#EF4444")
  isActive    Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  guideLinks  GuideExpertise[]
  experiences Experience[]

  @@map("categories")
}

model GuideExpertise {
  id             String            @id @default(cuid())
  guideProfileId String
  guideProfile   GuideProfile      @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])

  yearsOfExperience Int?

  @@unique([guideProfileId, categoryId])
  @@index([categoryId])
  @@map("guide_expertise")
}

// ── Guide-wide scheduling ────────────────────────────────────

// Vacation / sick leave / "not working these dates at all" — applies
// across every experience the guide offers. Distinct from per-experience
// availability windows on ExperienceAvailability.
model GuideBlockedPeriod {
  id             String       @id @default(cuid())
  guideProfileId String
  guideProfile   GuideProfile @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)

  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason    String?

  createdAt DateTime @default(now())

  @@index([guideProfileId, startDate, endDate])
  @@map("guide_blocked_periods")
}

// DB-level conflict guard for bookings.
// Inserted when booking is CONFIRMED. Deleted if booking is cancelled.
//
// Intentionally keyed on guideProfileId (not just experienceId):
// a guide can only physically run one experience at a time, regardless
// of which of their offerings it belongs to. experienceId is kept too,
// purely for audit/reporting ("which offering was this slot booked for").
//
// Implementation note: Use Prisma transactions with SELECT FOR UPDATE
// (advisory locks) when creating this record alongside booking confirmation.
// Pattern:
//   BEGIN;
//   SELECT pg_advisory_xact_lock(hashtext(guideProfileId || date));
//   INSERT INTO availability_locks ...;  ← fails on conflict
//   UPDATE bookings SET status = CONFIRMED ...;
//   COMMIT;
model AvailabilityLock {
  id             String       @id @default(cuid())
  guideProfileId String
  guideProfile   GuideProfile @relation(fields: [guideProfileId], references: [id])
  experienceId   String
  experience     Experience   @relation(fields: [experienceId], references: [id])
  bookingId      String       @unique
  booking        Booking      @relation(fields: [bookingId], references: [id])

  date      DateTime @db.Date
  startTime String   // "09:00" HH:MM
  endTime   String   // "11:00" HH:MM

  createdAt DateTime @default(now())

  // ⚠️ Architecture note:
  // No @@unique constraint here — it would only catch exact slot duplicates,
  // not time overlaps (09:00–11:00 vs 10:00–12:00).
  // True exclusivity is enforced by:
  //   1. pg_advisory_xact_lock in the booking service transaction
  //   2. Explicit overlap query before INSERT (see availability.service.ts)
  //   3. This table is the post-commit record, not the guard itself.

  @@index([guideProfileId, date]) // Overlap query target
  @@index([experienceId])
  @@map("availability_locks")
}

// ============================================================
// BOUNDED CONTEXT 3: EXPERIENCE DOMAIN
// ============================================================
// Responsibility: The actual bookable product.
//
// A guide doesn't sell "themselves" — they sell offerings:
// "Everest Base Camp Trek", "Kathmandu Heritage Walk", etc.
// Each has its own price, duration, capacity, category, and schedule.
//
//   GuideProfile 1───* Experience *───1 GuideProfile (via guideProfileId)
//   Experience   1───* ExperiencePricingRule   (versioned rates)
//   Experience   1───* ExperienceAvailability  (offering-specific schedule)
//   Experience   1───* Booking                 (what's actually purchased)
//
// Booking no longer stores guideId directly — the guide is reached via
// Booking → Experience → GuideProfile. One source of truth, zero drift.
// ============================================================

enum ExperienceStatus {
  DRAFT          // Guide is still editing, not visible to tourists
  PENDING_REVIEW // Submitted for admin/content review
  PUBLISHED      // Live and bookable
  REJECTED       // Failed review — see note via AuditLog/admin tooling
  ARCHIVED       // Guide took it down; historical bookings remain valid
}

enum ExperienceDifficulty {
  EASY
  MODERATE
  CHALLENGING
  DIFFICULT
}

model Experience {
  id             String       @id @default(cuid())
  guideProfileId String
  guideProfile   GuideProfile @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)

  title            String
  slug             String  @unique
  shortDescription String
  description      String  @db.Text

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  // Optional link to a curated Destination (e.g. "Everest Base Camp" as a
  // place). Experience still carries its own precise location/meeting
  // point below since not every experience maps to a catalogued destination
  // (e.g. a custom "Thamel Food Tour" with no Destination entry).
  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id])

  locationId        String
  location          Location  @relation("ExperienceLocation", fields: [locationId], references: [id])
  meetingLocationId String?
  meetingLocation   Location? @relation("ExperienceMeetingPoint", fields: [meetingLocationId], references: [id])

  difficulty      ExperienceDifficulty?
  durationHours   Decimal               @db.Decimal(5, 2)
  minParticipants Int                   @default(1)
  maxParticipants Int

  languagesOffered   String[] @default([])
  inclusions         String[] @default([])
  exclusions         String[] @default([])
  cancellationPolicy String?  @db.Text

  // Denormalized display price — cached from the currently active
  // ExperiencePricingRule. Mirrors the GuideProfile.averageRating pattern:
  // source of truth is ExperiencePricingRule, this is a read-optimization
  // for browse/listing pages that shouldn't need a join.
  basePrice Decimal  @db.Decimal(10, 2)
  currency  Currency @default(NPR)

  // Denormalized aggregate — updated by application after each review
  // (reachable via Booking.experienceId on the reviewed booking).
  averageRating Decimal          @default(0) @db.Decimal(3, 2)
  totalReviews  Int              @default(0)
  status        ExperienceStatus @default(DRAFT)
  isActive      Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coverImageId String?
  coverImage   Media?  @relation("ExperienceCoverImage", fields: [coverImageId], references: [id])

  images            ExperienceImage[]
  pricingRules      ExperiencePricingRule[]
  availability      ExperienceAvailability[]
  availabilityLocks AvailabilityLock[]
  bookings          Booking[]
  reports           Report[]

  @@index([guideProfileId])
  @@index([categoryId])
  @@index([destinationId])
  @@index([status, isActive])
  @@index([slug])
  @@map("experiences")
}

model ExperienceImage {
  id           String     @id @default(cuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  mediaId      String
  media        Media      @relation(fields: [mediaId], references: [id])

  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([experienceId, mediaId])
  @@index([experienceId])
  @@index([mediaId])
  @@map("experience_images")
}

// ── Pricing Rules (Decoupled from Booking) ──────────────────

// Pricing rules are the guide's offered rates for ONE experience —
// versioned, not mutated. When a booking is created, a PricingSnapshot
// is captured from the active rule at that moment. Future rule changes
// don't affect past bookings.
// This solves the "mutate old bookings vs duplicate logic" problem.
//
// Moved from GuideProfile → Experience: a guide's "Food Tour" and
// "Everest Trek" have entirely different rate structures; a single
// guide-wide rate made no sense once Experience exists.

enum PricingUnit {
  PER_HOUR
  PER_DAY
  PER_PERSON
  PER_GROUP
  FLAT_RATE
}

enum Currency {
  NPR
  USD
}

model ExperiencePricingRule {
  id           String     @id @default(cuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  name     String      // "Standard Day Rate", "Evening Tour", "Peak Season"
  unit     PricingUnit
  amount   Decimal     @db.Decimal(10, 2)
  currency Currency    @default(NPR)

  // Optional constraints on when this rule applies
  validFrom    DateTime?
  validUntil   DateTime?
  minGroupSize Int?
  maxGroupSize Int?
  isActive     Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Snapshots reference back to the rule that was active at booking time
  snapshots BookingPricingSnapshot[]

  @@index([experienceId, isActive])
  @@map("experience_pricing_rules")
}

// ── Availability System ──────────────────────────────────────
// Per-offering schedule. A guide may run "Food Tour" Mon/Wed/Fri
// while "Everest Trek" is only offered Oct–Nov — these are properties
// of the Experience, not the Guide.

model ExperienceAvailability {
  id           String     @id @default(cuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  // Date stored as Date type — no timezone ambiguity for calendar display
  date      DateTime @db.Date
  // Null startTime/endTime = full day availability
  startTime String?  // "09:00" — stored as HH:MM string for simplicity
  endTime   String?  // "17:00"

  isRecurring Boolean @default(false)
  // Recurrence stored as string: "WEEKLY:MON,WED,FRI" — flexible, parseable.
  // Avoids RecurrencePattern enum lock-in for future patterns.
  recurrenceRule   String?
  recurrenceEndsAt DateTime? @db.Date

  note      String?
  createdAt DateTime @default(now())

  @@unique([experienceId, date, startTime])
  @@index([experienceId, date])
  @@map("experience_availability")
}

// ============================================================
// BOUNDED CONTEXT 4: BOOKING & COMMERCE
// ============================================================
// Responsibility: Scheduling intent, pricing contracts,
// state machine, payment execution.
//
// Key decomposition:
//   Booking                → WHO, WHEN, HOW MANY (scheduling intent against
//                            a specific Experience — guide/location/price
//                            are all reached through Experience, not duplicated)
//   BookingPricingSnapshot → WHAT WAS AGREED (immutable financial contract)
//   BookingStateLog        → HOW IT EVOLVED (state machine audit trail)
//   Payment                → MONEY MOVEMENT (financial execution)
//
// Booking is no longer fat — each sub-model has one job.
// ============================================================

enum BookingStatus {
  PENDING     // Awaiting guide response
  CONFIRMED   // Guide accepted
  IN_PROGRESS // Trip active
  COMPLETED   // Successfully finished
  CANCELLED   // Cancelled — see BookingStateLog for reason
  REJECTED    // Guide declined
  NO_SHOW     // Tourist absent
  DISPUTED    // Under admin review
  EXPIRED     // Booking request timed out without guide response
}

// Booking — scheduling intent only.
// No payment state here — that lives in Payment.
// No cancellation reason here — that lives in BookingStateLog.
// No pricing details here — that lives in BookingPricingSnapshot.
// No guideId/destinationId/meetingLocationId here — all reached via
// Experience, which is the single source of truth for what's being sold.
model Booking {
  id        String @id @default(cuid())
  touristId String
  tourist   User   @relation("TouristBookings", fields: [touristId], references: [id])

  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id])

  // Current state as a first-class column — fast reads without subquery.
  // BookingStateLog remains authoritative for HOW it got here.
  // Application MUST update both in the same transaction.
  // Never update status without writing a BookingStateLog row.
  status        BookingStatus @default(PENDING)
  tripDate      DateTime      @db.Date
  startTime     String?
  endTime       String?
  durationHours Decimal?      @db.Decimal(4, 2)
  groupSize     Int           @default(1)
  touristNote   String?       @db.Text
  guideNote     String?       @db.Text
  currency      Currency      @default(NPR)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricingSnapshot  BookingPricingSnapshot?
  stateLog         BookingStateLog[]
  payments         Payment[]
  review           Review?
  availabilityLock AvailabilityLock?
  conversation     Conversation?           @relation("BookingConversation")
  promoUsage       PromoCodeUsage?
  reports          Report[]

  @@index([touristId, status])    // Tourist dashboard: filter by status
  @@index([experienceId, status]) // Guide dashboard: filter by status
  @@index([status, tripDate])     // Admin: upcoming bookings by status
  @@index([touristId])
  @@index([experienceId])
  @@index([tripDate])
  @@index([createdAt])
  @@map("bookings")
}

model BookingPricingSnapshot {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // Reference to the rule that was active — for audit/analytics
  pricingRuleId String?
  pricingRule   ExperiencePricingRule? @relation(fields: [pricingRuleId], references: [id])

  // Snapshot values — never reference live pricing rules for calculations
  unit          PricingUnit
  agreedRate    Decimal     @db.Decimal(10, 2)
  currency      Currency    @default(NPR)
  groupSize     Int
  durationHours Decimal?    @db.Decimal(4, 2)

  // Computed breakdown — calculated once at booking time
  baseAmount         Decimal  @db.Decimal(10, 2)
  discountAmount     Decimal  @default(0) @db.Decimal(10, 2)
  platformFeeAmount  Decimal  @db.Decimal(10, 2)
  platformFeePercent Decimal  @db.Decimal(5, 2)  // e.g. 10.00 = 10%
  taxAmount          Decimal  @default(0) @db.Decimal(10, 2)
  totalAmount        Decimal  @db.Decimal(10, 2)

  // If a promo was applied — code snapshot for audit
  promoCodeApplied    String?
  promoDiscountAmount Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  // No updatedAt — this record must never be updated after creation.

  @@map("booking_pricing_snapshots")
}

// Append-only state machine log — the authoritative history of a booking's lifecycle.
// Each status transition creates a new row. Nothing is ever updated.
//
// This replaces: cancelledAt, cancelledById, cancellationReason, confirmedAt, etc.
// All transition metadata lives here — Booking stays clean.
//
// Query current state: SELECT * FROM booking_state_log WHERE bookingId = ? ORDER BY createdAt DESC LIMIT 1
// Query full history:  SELECT * FROM booking_state_log WHERE bookingId = ? ORDER BY createdAt ASC
model BookingStateLog {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  fromStatus BookingStatus? // Null for initial PENDING state
  toStatus   BookingStatus

  // Actor who triggered this transition
  actorId   String // UserId
  actorRole Role

  // Structured reason — string not enum to avoid migration on new reasons
  reason     String?
  reasonCode String?  // Machine-readable: "GUIDE_EMERGENCY", "WEATHER", "NO_PAYMENT"
  note       String?  @db.Text

  // Metadata for disputed/admin-action states
  metadata Json?

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([toStatus])
  @@index([actorId])
  @@index([createdAt])
  @@map("booking_state_log")
}

// ── Destinations ─────────────────────────────────────────────
// A curated "place" (e.g. "Everest Base Camp") — used for browsing and
// SEO landing pages. Distinct from Experience: a Destination can have
// many Experiences offered against it by different guides.

model Destination {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text

  // FK to shared Location — single source of truth for geo data
  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  coverImageId String?
  coverImage   Media?  @relation(fields: [coverImageId], references: [id])

  images    DestinationImage[]
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  experiences Experience[]

  @@index([slug])
  @@index([isActive])
  @@map("destinations")
}

model DestinationImage {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  mediaId       String
  media         Media       @relation(fields: [mediaId], references: [id])

  createdAt DateTime @default(now())

  @@unique([destinationId, mediaId])
  @@index([destinationId])
  @@index([mediaId])
  @@map("destination_images")
}

// ============================================================
// BOUNDED CONTEXT 5: PAYMENT
// ============================================================
// Responsibility: Money movement only.
// No booking state logic here — state lives in BookingStateLog.
// Payment has its own state machine (PaymentStateLog).
// ============================================================

// PaymentStatus as enum is justified here —
// these are stable financial states with clear definitions.
// Unlike booking statuses, payment states map 1:1 to gateway events.
enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  FULLY_REFUNDED
}

enum PaymentMethod {
  ESEWA
  KHALTI
  CASH
  BANK_TRANSFER
  // Future: STRIPE, PAYPAL — add without breaking existing data
}

enum PaymentType {
  BOOKING_PAYMENT
  REFUND
  PARTIAL_REFUND
  PLATFORM_FEE_SETTLEMENT
  GUIDE_PAYOUT
}

// One booking → many payments (initial payment + possible refunds).
// Payment is immutable after settlement — append refund records instead.
model Payment {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  paymentType   PaymentType   @default(BOOKING_PAYMENT)
  paymentMethod PaymentMethod
  amount        Decimal       @db.Decimal(10, 2)
  currency      Currency      @default(NPR)
  status        PaymentStatus @default(PENDING)

  // Gateway data — JSON acceptable here: raw gateway payloads are unstructured
  // and should not drive business logic. Stored for reconciliation only.
  transactionRef       String?   @unique // Our internal reference
  gatewayTransactionId String?           // Gateway's reference
  gatewayResponse      Json?

  initiatedAt   DateTime  @default(now())
  paidAt        DateTime?
  failedAt      DateTime?
  failureReason String?

  stateLog PaymentStateLog[]

  // For refund records — links back to original payment
  parentPaymentId String?
  parentPayment   Payment?  @relation("PaymentRefunds", fields: [parentPaymentId], references: [id])
  refunds         Payment[] @relation("PaymentRefunds")

  @@index([bookingId])
  @@index([status])
  @@index([transactionRef])
  @@index([paymentMethod])
  @@index([gatewayTransactionId])
  @@index([initiatedAt])
  @@map("payments")
}

// Append-only payment state log — mirrors BookingStateLog pattern.
// Every payment status change creates a new record.
model PaymentStateLog {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  fromStatus   PaymentStatus?
  toStatus     PaymentStatus
  // Gateway event that triggered this transition
  gatewayEvent String?
  note         String?
  metadata     Json?

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@map("payment_state_log")
}

// ── Promo Codes ──────────────────────────────────────────────

// Future-proof promo system — referenced from BookingPricingSnapshot.
// Adding promo codes required zero schema changes to Booking or Pricing.
model PromoCode {
  id          String  @id @default(cuid())
  code        String  @unique
  description String?

  discountType      String   // "PERCENTAGE" | "FLAT"
  discountValue     Decimal  @db.Decimal(10, 2)
  maxDiscountAmount Decimal? @db.Decimal(10, 2)
  minBookingAmount  Decimal? @db.Decimal(10, 2)
  maxUsageCount     Int?     // Null = unlimited
  usageCount        Int      @default(0)
  maxUsagePerUser   Int      @default(1)

  validFrom  DateTime
  validUntil DateTime
  isActive   Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usages PromoCodeUsage[]

  @@index([code, isActive])
  @@map("promo_codes")
}

model PromoCodeUsage {
  id          String    @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  bookingId   String    @unique
  booking     Booking   @relation(fields: [bookingId], references: [id])
  userId      String

  discountApplied Decimal  @db.Decimal(10, 2)
  usedAt          DateTime @default(now())

  @@index([promoCodeId])
  @@index([userId])
  @@map("promo_code_usages")
}

// ============================================================
// BOUNDED CONTEXT 6: REVIEW & MODERATION
// ============================================================
// Responsibility: Structured feedback collection + moderation workflow.
// Review moderation is now a first-class workflow, not an afterthought.
// ============================================================

enum ReviewStatus {
  VISIBLE
  FLAGGED  // Report received, admin notified
  HIDDEN   // Admin decision
  DELETED
}

// Core review — tied to booking (1:1 enforced by @unique), NOT to
// guide or experience directly. This guarantees:
//   - only a tourist with a real completed booking can review
//   - exactly one review per booking (no duplicate/fake reviews)
//   - the experience/guide being reviewed is always derivable via
//     Review.booking.experience, so no separate FK is needed
// Tourist reviews guide only (platform decision — guides can respond but not rate).
model Review {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])
  authorId  String
  author    User    @relation("ReviewAuthor", fields: [authorId], references: [id])
  subjectId String
  subject   User    @relation("ReviewSubject", fields: [subjectId], references: [id])

  // Structured ratings between 1-5 — easier to query/aggregate than JSON
  overallRating       Int
  communicationRating Int?
  punctualityRating   Int?
  knowledgeRating     Int?
  valueRating         Int?

  comment       String?      @db.Text
  status        ReviewStatus @default(VISIBLE)
  guideResponse String?      @db.Text
  respondedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Single audit log — handles edits, moderation, status changes
  auditLog       ReviewAuditLog[]
  reports        ReviewReport[]
  generalReports Report[]

  @@index([subjectId])
  @@index([authorId])
  @@index([status])
  @@index([overallRating])
  @@map("reviews")
}

model ReviewAuditLog {
  id       String @id @default(cuid())
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  // String not enum — new event types need zero migrations.
  // Valid values: "EDITED" | "STATUS_CHANGED" | "GUIDE_RESPONDED" | "REPORT_RESOLVED"
  eventType String
  actorId   String // UserId of who triggered the event

  // Snapshot of what changed — JSON acceptable here:
  // structure varies per eventType, this is audit data not business logic
  previousState Json?
  newState      Json?
  note          String?

  createdAt DateTime @default(now())

  @@index([reviewId])
  @@index([eventType])
  @@map("review_audit_log")
}

// Kept as separate model — user-reporting is a launch feature,
// needs its own resolution workflow and indexes.
// No separate bookingId here — booking context is always reachable via
// ReviewReport.review.bookingId, so it isn't duplicated.
model ReviewReport {
  id       String @id @default(cuid())
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  reporterId     String
  reason         String    // "SPAM" | "OFFENSIVE" | "FAKE" | "OTHER"
  detail         String?
  createdAt      DateTime  @default(now())
  isResolved     Boolean   @default(false)
  resolvedAt     DateTime?
  resolvedById   String?
  resolutionNote String?

  @@unique([reviewId, reporterId])
  @@index([isResolved])
  @@map("review_reports")
}

// ============================================================
// GENERAL REPORTS
// ============================================================

enum ReportTargetType {
  USER
  REVIEW
  BOOKING
  EXPERIENCE
  MESSAGE
  CONTENT
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE_CONTENT
  FAKE_PROFILE
  SCAM
  DISCRIMINATION
  VIOLENCE
  COPYRIGHT
  PRIVACY
  OTHER
}

enum ResolutionAction {
  NO_ACTION
  WARNING
  CONTENT_REMOVED
  SUSPENDED
  BANNED
}

model Report {
  id         String @id @default(cuid())
  reporterId String
  reporter   User   @relation("ReportReporter", fields: [reporterId], references: [id])

  // targetType + targetId kept for application-layer routing and analytics.
  // Do NOT use targetId for DB joins — use the explicit FKs below.
  targetType ReportTargetType
  targetId   String           // Denormalized copy — for audit/analytics only

  // Explicit FKs for DB integrity — exactly one should be non-null.
  // Enforced by application service layer.
  // Message reports intentionally excluded: messages can be soft-deleted and
  // a report must survive the deletion — targetId still captures the messageId
  // for admin lookup; the admin service handles the "message may be gone" case.
  targetUserId       String?
  targetUser         User?       @relation("ReportTarget", fields: [targetUserId], references: [id])
  targetReviewId     String?
  targetReview       Review?     @relation(fields: [targetReviewId], references: [id])
  targetBookingId    String?
  targetBooking      Booking?    @relation(fields: [targetBookingId], references: [id])
  targetExperienceId String?
  targetExperience   Experience? @relation(fields: [targetExperienceId], references: [id])

  reason ReportReason
  detail String?      @db.Text

  status ReportStatus @default(PENDING)

  resolvedAt       DateTime?
  resolvedById     String?           // Admin UserId — not FK to avoid circular dependency
  resolutionNote   String?
  // Enum enforced — BANNED triggers UserBan creation, SUSPENDED triggers
  // account lock. These are code paths, not display strings.
  resolutionAction ResolutionAction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reporterId])
  @@index([targetType, targetId]) // Analytics/grouping queries
  @@index([targetUserId])
  @@index([targetReviewId])
  @@index([targetBookingId])
  @@index([targetExperienceId])
  @@index([status])
  @@index([createdAt])
  @@map("reports")
}

// ============================================================
// BOUNDED CONTEXT 7: COMMUNICATION
// ============================================================
// Responsibility: Real-time messaging infrastructure.
// Designed for tourist ↔ guide. Architected for group chat extension.
// ============================================================

model Conversation {
  id        String   @id @default(cuid())

  // Optional booking link — not all chats need a booking
  bookingId String?  @unique
  booking   Booking? @relation("BookingConversation", fields: [bookingId], references: [id])

  // Denormalized for list performance — updated on each message.
  // Alternative: use DB view. Chosen here for simpler service code.
  lastMessageAt   DateTime?
  lastMessageText String?
  isGroup         Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Per-participant read cursor — supports unread count without expensive scan
  lastReadAt        DateTime?
  lastReadMessageId String?
  lastReadMessage   Message?  @relation("ParticipantLastReadMessage", fields: [lastReadMessageId], references: [id])
  isActive          Boolean   @default(true)
  joinedAt          DateTime  @default(now())
  leftAt            DateTime?

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("conversation_participants")
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  LOCATION_SHARE
  BOOKING_CARD // Rich message type for booking updates in chat
  SYSTEM       // System-generated: "Booking confirmed"
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])

  type    MessageType @default(TEXT)
  content String?     @db.Text

  // Location share payload — structured, not JSON
  locationLatitude  Decimal? @db.Decimal(10, 7)
  locationLongitude Decimal? @db.Decimal(10, 7)

  // Reply chain — self-referential for threaded replies
  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id])
  replies   Message[] @relation("MessageReplies")

  lastReadByParticipants ConversationParticipant[] @relation("ParticipantLastReadMessage")

  // Soft delete — show "Message deleted" in UI
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  isEdited  Boolean   @default(false)
  editedAt  DateTime?

  createdAt DateTime @default(now())

  attachments MessageAttachment[]

  @@index([conversationId, createdAt]) // Pagination query
  @@index([senderId])
  @@map("messages")
}

model MessageAttachment {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media   @relation(fields: [mediaId], references: [id])
  fileName  String

  createdAt DateTime @default(now())

  @@index([messageId])
  @@map("message_attachments")
}

// ============================================================
// BOUNDED CONTEXT 8: NOTIFICATIONS
// ============================================================

// NotificationType as string constant in application — not enum.
// Reason: Every new feature adds a notification type.
// String column avoids migration on each product update.
// Application layer validates against a constants file.
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // String instead of enum — avoids migration cost on new notification types
  type    String
  channel String @default("IN_APP") // "IN_APP" | "PUSH" | "EMAIL" | "SMS"
  title   String
  body    String
  imageKey String?

  // Navigation payload — JSON acceptable here (display/routing data only,
  // never used for business logic decisions)
  payload Json?

  isRead  Boolean   @default(false)
  readAt  DateTime?

  // Push delivery tracking
  isSent     Boolean   @default(false)
  sentAt     DateTime?
  failedAt   DateTime?
  failReason String?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([type])
  @@map("notifications")
}

// ============================================================
// BOUNDED CONTEXT 9: PLATFORM ADMINISTRATION
// ============================================================

// Runtime configuration — avoids deploys for config changes.
// e.g., "platform_fee_pct" = "10.00", "maintenance_mode" = "false"
model PlatformConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  dataType    String   @default("string") // "string" | "number" | "boolean" | "json"
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("platform_configs")
}

// Immutable audit log — append-only, no cascades.
// Covers: admin actions, sensitive user operations, system events.
// Never delete from this table — it is the compliance record.
model AuditLog {
  id      String @id @default(cuid())

  // Null actorId = system-initiated action
  actorId String?
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id])

  targetId   String?
  targetType String  // "User" | "Booking" | "GuideProfile" | "Experience" | "Payment"
  action     String  // "VERIFY_GUIDE" | "BAN_USER" | "ISSUE_REFUND" | "PUBLISH_EXPERIENCE"

  // JSON for before/after state — acceptable here since it's unstructured audit data
  previousState Json?
  newState      Json?
  ipAddress     String?
  userAgent     String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([targetId, targetType])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}