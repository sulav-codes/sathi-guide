DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME"

NODE_ENV=development
PORT=3000
APP_NAME="SathiGuide API"

JWT_ACCESS_SECRET=your-secure-access-token-secret
JWT_ACCESS_EXPIRES_IN_MINUTES=15

JWT_REFRESH_SECRET=your-secure-refresh-token-secret
JWT_REFRESH_EXPIRES_IN_DAYS=30

PASSWORD_RESET_EXPIRES_IN_MINUTES=15

THROTTLE_TTL=60000
THROTTLE_LIMIT=10

RESEND_API_KEY=your-resend-api-key
MAIL_FROM="SathiGuide <onboarding@resend.dev>"

FRONTEND_URL=https://your-frontend-url.com

# ─── Supabase Storage ────────────────────────────
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET_EXPERIENCE=your-experience-bucket
SUPABASE_BUCKET_AVATAR=your-avatar-bucket
SUPABASE_BUCKET_DOCUMENT=your-document-bucket